# =================================================================
# KLE Society's Tech Fest 2026 - Environment Configuration Template
# =================================================================
# Copy this file to `.env` for local development.
# DO NOT commit `.env` containing production secrets to Git.

# -----------------------------------------------------------------
# 1. Supabase Database & Auth Configuration
# -----------------------------------------------------------------
SUPABASE_URL=https://your-supabase-project.supabase.co
SUPABASE_ANON_KEY=your-supabase-anon-key-here
# Optional: Service key to bypass RLS policies for backend admin operations
SUPABASE_SERVICE_KEY=your-supabase-service-role-key-here

# -----------------------------------------------------------------
# 2. Flask Backend Server Configuration
# -----------------------------------------------------------------
# Generate a secure 32+ character random string for production
FLASK_SECRET_KEY=your-random-32-character-secret-key
FLASK_ENV=production
PORT=5000

# -----------------------------------------------------------------
# 3. Frontend API Base URL (Vite Build Variable)
# -----------------------------------------------------------------
# Set this to your Render Backend Web Service URL (e.g. https://kle-techfest-backend.onrender.com/api)
VITE_API_URL=https://kle-techfest-backend.onrender.com/api
